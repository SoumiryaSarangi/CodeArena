# Edge for the API VM (D-02). TLS certificates are obtained and renewed automatically (Let's
# Encrypt, with ZeroSSL as fallback; no contact e-mail is configured on purpose: an empty `email`
# directive is a syntax error, so it is not offered). API_HOST is api.<ip-with-dashes>.sslip.io until a real domain
# exists; WEB_ORIGIN is the Vercel site (https://something.vercel.app).
{$API_HOST} {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# The realtime stream: straight from the browser to here (Vercel cannot carry it), so it needs
	# CORS for the web origin. The one-time ticket in the URL is the credential; no cookies. No
	# compression and no buffering, or events would arrive late (SD-§10).
	@sse path /api/sse
	handle @sse {
		header Access-Control-Allow-Origin "{$WEB_ORIGIN}"
		header Vary "Origin"
		reverse_proxy api:4000 {
			flush_interval -1
		}
	}

	# Problem package uploads and test downloads (UI-04): a folder of tests can be tens of megabytes, more
	# than the Vercel rewrite is meant to carry, so the browser talks straight to here with its bearer
	# token (no cookie is involved). CORS for the web origin only, including the preflight a bearer header triggers.
	@upload path /api/admin/problems/packages /api/admin/problem-versions/*/tests.tar /api/admin/problem-versions/*/tests/*
	handle @upload {
		header Access-Control-Allow-Origin "{$WEB_ORIGIN}"
		header Access-Control-Allow-Headers "Authorization"
		header Access-Control-Allow-Methods "GET, POST"
		header Access-Control-Expose-Headers "Content-Disposition"
		header Access-Control-Max-Age "600"
		header Vary "Origin"
		@preflight method OPTIONS
		respond @preflight 204
		reverse_proxy api:4000
	}

	handle /api/* {
		encode zstd gzip
		reverse_proxy api:4000
	}

	# Collaborative pad (CP-03): two collab instances, and every request for one room id goes to the same one
	# (`uri_hash`, SD-§11.3), so a room normally lives on one instance. The URL carries the room id and nothing that
	# changes between reconnects. A dead instance is skipped (active health check, and a connection that fails is retried
	# on the other for a few seconds); with none running the answer is the same friendly 503 as before they existed.
	# COLLAB_UPSTREAMS overrides the two addresses (the Caddy test points it at local fakes).
	handle /collab/* {
		reverse_proxy {$COLLAB_UPSTREAMS:collab1:1234 collab2:1234} {
			lb_policy uri_hash
			lb_try_duration 3s
			lb_try_interval 250ms
			health_uri /
			health_interval 5s
			health_timeout 2s
			fail_duration 10s
			max_fails 1
		}
	}

	handle_errors {
		@pad path /collab/*
		respond @pad "The collaborative pad is not available right now." 503
	}

	handle {
		respond "CodeArena API" 200
	}
}
