{
  "uid": "ca-judge-fleet",
  "title": "CodeArena · Judge fleet",
  "description": "Judge workers: load, health and recovery events (O-01).",
  "tags": ["codearena"],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "10s",
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "type": "datasource",
        "name": "ds",
        "label": "Data source",
        "query": "prometheus",
        "current": {},
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Busy ratio by worker",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ca_judge_busy_ratio",
          "legendFormat": "{{worker}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "description": "Jobs in progress over concurrency. A worker missing here for 30 s is an alert."
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Jobs in flight",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(ca_judge_inflight)",
          "legendFormat": "in flight",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Jobs finished per minute by outcome",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(ca_judge_jobs_total[5m])) * 60",
          "legendFormat": "{{outcome}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Judge job duration p95 by lane",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, lane) (rate(ca_judge_job_seconds_bucket[5m])))",
          "legendFormat": "{{lane}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Reclaimed / lease lost / quarantined (last hour)",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(ca_queue_reclaimed_total[1h]))",
          "legendFormat": "reclaimed",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "instant": true
        },
        {
          "refId": "B",
          "expr": "sum(increase(ca_queue_lease_lost_total[1h]))",
          "legendFormat": "lease lost",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "instant": true
        },
        {
          "refId": "C",
          "expr": "sum(increase(ca_queue_quarantined_total[1h]))",
          "legendFormat": "quarantined",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Checker (jury) errors (last hour)",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(ca_judge_jury_errors_total[1h]))",
          "legendFormat": "jury errors",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "description": "A checker failed: the problem is broken."
    }
  ]
}
