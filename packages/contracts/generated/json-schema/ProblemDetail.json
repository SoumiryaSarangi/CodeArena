{
  "$id": "ProblemDetail.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "checker": {
      "additionalProperties": false,
      "properties": {
        "eps": {
          "type": "number"
        },
        "kind": {
          "enum": [
            "exact",
            "tokens",
            "float",
            "testlib"
          ],
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    "difficulty": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
    },
    "limits": {
      "additionalProperties": false,
      "properties": {
        "memMb": {
          "type": "number"
        },
        "outputKb": {
          "type": "number"
        },
        "timeMs": {
          "type": "number"
        }
      },
      "required": [
        "timeMs",
        "memMb",
        "outputKb"
      ],
      "type": "object"
    },
    "practicePoints": {
      "anyOf": [
        {
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "samples": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "in": {
            "type": "string"
          },
          "out": {
            "type": "string"
          }
        },
        "required": [
          "in",
          "out"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "slug": {
      "type": "string"
    },
    "statementMd": {
      "type": "string"
    },
    "tags": {
      "items": {
        "maxLength": 30,
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "title": {
      "type": "string"
    },
    "version": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "type": "integer"
    }
  },
  "required": [
    "slug",
    "title",
    "difficulty",
    "tags",
    "practicePoints",
    "version",
    "statementMd",
    "samples",
    "limits",
    "checker"
  ],
  "type": "object"
}
