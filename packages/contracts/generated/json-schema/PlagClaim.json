{
  "$id": "PlagClaim.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "params": {
      "additionalProperties": {},
      "propertyNames": {
        "type": "string"
      },
      "type": "object"
    },
    "problems": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "problemId": {
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "submissions": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "id": {
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                  "type": "string"
                },
                "language": {
                  "type": "string"
                },
                "source": {
                  "type": "string"
                },
                "user": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "language",
                "source",
                "user"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "templates": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "language": {
                  "type": "string"
                },
                "source": {
                  "type": "string"
                }
              },
              "required": [
                "language",
                "source"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "problemId",
          "slug",
          "templates",
          "submissions"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "runId": {
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "type": "string"
    }
  },
  "required": [
    "runId",
    "params",
    "problems"
  ],
  "type": "object"
}
