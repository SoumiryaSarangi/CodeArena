{
  "$id": "ContestProblemsPut.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "items": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "label": {
            "pattern": "^[A-Z]$",
            "type": "string"
          },
          "slug": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "label",
          "slug"
        ],
        "type": "object"
      },
      "maxItems": 26,
      "type": "array"
    }
  },
  "required": [
    "items"
  ],
  "type": "object"
}
