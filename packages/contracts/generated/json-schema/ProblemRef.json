{
  "$id": "ProblemRef.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "checker": {
      "$ref": "Checker.json"
    },
    "limits": {
      "$ref": "Limits.json"
    },
    "testsetHash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "testsetUri": {
      "pattern": "^s3:\\/\\/[^/?#]+\\/testsets\\/[^?#]+$",
      "type": "string"
    },
    "versionId": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "versionId",
    "testsetHash",
    "testsetUri",
    "checker",
    "limits"
  ],
  "type": "object"
}
