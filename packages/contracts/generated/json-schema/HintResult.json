{
  "$id": "HintResult.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "hint": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "cached": {
              "type": "boolean"
            },
            "generic": {
              "type": "boolean"
            },
            "id": {
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "type": "string"
            },
            "level": {
              "anyOf": [
                {
                  "const": 1,
                  "type": "number"
                },
                {
                  "const": 2,
                  "type": "number"
                },
                {
                  "const": 3,
                  "type": "number"
                }
              ]
            },
            "penaltyPercent": {
              "maximum": 9007199254740991,
              "minimum": -9007199254740991,
              "type": "integer"
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "level",
            "text",
            "penaltyPercent",
            "cached",
            "generic"
          ],
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "nudge": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "hint",
    "nudge"
  ],
  "type": "object"
}
