{
  "$id": "HintItem.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "costPercent": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
    },
    "helpful": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "hintId": {
      "anyOf": [
        {
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "level": {
      "anyOf": [
        {
          "const": 1,
          "type": "number"
        },
        {
          "const": 2,
          "type": "number"
        },
        {
          "const": 3,
          "type": "number"
        }
      ]
    },
    "status": {
      "enum": [
        "locked",
        "available",
        "delivered"
      ],
      "type": "string"
    },
    "text": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "level",
    "status",
    "costPercent",
    "hintId",
    "text",
    "helpful"
  ],
  "type": "object"
}
