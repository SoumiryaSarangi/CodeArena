{
  "$id": "ClarificationCreate.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "problemLabel": {
      "anyOf": [
        {
          "pattern": "^[A-Z]$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "question": {
      "maxLength": 2000,
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "question"
  ],
  "type": "object"
}
