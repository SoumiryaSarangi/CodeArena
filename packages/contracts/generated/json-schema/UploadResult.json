      "minimum": -9007199254740991,
      "type": "integer"
    },
    "version": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "type": "integer"
    },
    "versionId": {
      "type": "string"
    }
  },
  "required": [
    "outcome",
    "slug",
    "versionId",
    "version",
    "testsCount"
  ],
  "type": "object"
