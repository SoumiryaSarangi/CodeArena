{
  "$id": "PatchMe.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "defaultLanguage": {
      "$ref": "Language.json"
    },
    "handle": {
      "pattern": "^[a-z][a-z0-9_.]{2,19}$",
      "type": "string"
    }
  },
  "type": "object"
}
