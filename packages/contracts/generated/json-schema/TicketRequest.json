{
  "$id": "TicketRequest.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "additionalProperties": false,
      "properties": {
        "topics": {
          "items": {
            "maxLength": 128,
            "pattern": "^(sys|admin:[a-z0-9:_-]+|sub:[0-9a-f-]{36}|contest:[0-9a-f-]{36}:[a-z0-9:_-]+)$",
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "topics"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "roomId": {
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
          "type": "string"
        }
      },
      "required": [
        "roomId"
      ],
      "type": "object"
    }
  ]
}
