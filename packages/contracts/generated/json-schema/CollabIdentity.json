{
  "$id": "CollabIdentity.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "colorIndex": {
      "maximum": 7,
      "minimum": 0,
      "type": "integer"
    },
    "expiresAt": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
    },
    "name": {
      "maxLength": 60,
      "minLength": 1,
      "type": "string"
    },
    "readOnly": {
      "type": "boolean"
    },
    "role": {
      "enum": [
        "interviewer",
        "candidate",
        "observer"
      ],
      "type": "string"
    },
    "userId": {
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "type": "string"
    }
  },
  "required": [
    "userId",
    "name",
    "role",
    "readOnly",
    "expiresAt",
    "colorIndex"
  ],
  "type": "object"
}
