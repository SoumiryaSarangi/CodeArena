{
  "$id": "PublicVerdicts.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "items": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "at": {
            "type": "string"
          },
          "language": {
            "type": "string"
          },
          "problemTitle": {
            "type": "string"
          },
          "timeMs": {
            "anyOf": [
              {
                "maximum": 9007199254740991,
                "minimum": -9007199254740991,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "verdict": {
            "$ref": "Verdict.json"
          }
        },
        "required": [
          "language",
          "problemTitle",
          "verdict",
          "timeMs",
          "at"
        ],
        "type": "object"
      },
      "maxItems": 10,
      "type": "array"
    }
  },
  "required": [
    "items"
  ],
  "type": "object"
}
