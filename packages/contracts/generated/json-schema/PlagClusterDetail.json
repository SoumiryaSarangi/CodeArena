{
  "$id": "PlagClusterDetail.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "contestId": {
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "type": "string"
    },
    "decisions": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "createdAt": {
            "type": "string"
          },
          "decision": {
            "enum": [
              "clear",
              "confirm",
              "discuss"
            ],
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "reviewer": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "decision",
          "note",
          "reviewer",
          "createdAt"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "id": {
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "type": "string"
    },
    "maxScore": {
      "type": "number"
    },
    "members": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "handle": {
            "type": "string"
          },
          "language": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "submissionId": {
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
            "type": "string"
          },
          "submittedAt": {
            "type": "string"
          },
          "verdict": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "submissionId",
          "handle",
          "language",
          "verdict",
          "submittedAt",
          "source"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "pairs": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "combined": {
            "type": "number"
          },
          "embScore": {
            "type": [
              "number",
              "null"
            ]
          },
          "fpScore": {
            "type": [
              "number",
              "null"
            ]
          },
          "subA": {
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
            "type": "string"
          },
          "subB": {
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
            "type": "string"
          }
        },
        "required": [
          "subA",
          "subB",
          "fpScore",
          "embScore",
          "combined"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "problemId": {
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "type": "string"
    },
    "problemSlug": {
      "type": "string"
    },
    "runId": {
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "type": "string"
    },
    "signals": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "at": {
            "type": "string"
          },
          "handle": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "size": {
            "type": [
              "number",
              "null"
            ]
          }
        },
        "required": [
          "handle",
          "kind",
          "size",
          "at"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "status": {
      "enum": [
        "open",
        "clear",
        "confirm",
        "discuss"
      ],
      "type": "string"
    }
  },
  "required": [
    "id",
    "runId",
    "contestId",
    "problemId",
    "problemSlug",
    "maxScore",
    "status",
    "members",
    "pairs",
    "signals",
    "decisions"
  ],
  "type": "object"
}
