{
  "$id": "BoardDiffData.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "contestId": {
      "type": "string"
    },
    "frozen": {
      "type": "boolean"
    },
    "rows": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "cells": {
            "additionalProperties": {
              "$ref": "BoardCell.json"
            },
            "propertyNames": {
              "type": "string"
            },
            "type": "object"
          },
          "handle": {
            "type": "string"
          },
          "lastAcMinute": {
            "anyOf": [
              {
                "maximum": 9007199254740991,
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "penalty": {
            "maximum": 9007199254740991,
            "minimum": 0,
            "type": "integer"
          },
          "score": {
            "maximum": 9007199254740991,
            "minimum": -9007199254740991,
            "type": "integer"
          },
          "solved": {
            "maximum": 9007199254740991,
            "minimum": 0,
            "type": "integer"
          },
          "userId": {
            "type": "string"
          }
        },
        "required": [
          "userId",
          "handle",
          "solved",
          "penalty",
          "lastAcMinute",
          "score",
          "cells"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "version": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "contestId",
    "version",
    "frozen",
    "rows"
  ],
  "type": "object"
}
