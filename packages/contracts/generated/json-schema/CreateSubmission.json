{
  "$id": "CreateSubmission.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "contestSlug": {
      "maxLength": 100,
      "minLength": 1,
      "type": "string"
    },
    "label": {
      "pattern": "^[A-Z]$",
      "type": "string"
    },
    "language": {
      "maxLength": 20,
      "minLength": 1,
      "type": "string"
    },
    "problemSlug": {
      "maxLength": 100,
      "minLength": 1,
      "type": "string"
    },
    "source": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "language",
    "source"
  ],
  "type": "object"
}
