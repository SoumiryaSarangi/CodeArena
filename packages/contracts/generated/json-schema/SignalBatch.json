{
  "$id": "SignalBatch.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "contest": {
      "maxLength": 80,
      "minLength": 1,
      "type": "string"
    },
    "events": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "at": {
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
            "type": "string"
          },
          "kind": {
            "enum": [
              "paste",
              "blur",
              "focus",
              "tab_hidden",
              "problem_open"
            ],
            "type": "string"
          },
          "size": {
            "maximum": 10000000,
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "kind",
          "at"
        ],
        "type": "object"
      },
      "maxItems": 50,
      "minItems": 1,
      "type": "array"
    },
    "problem": {
      "maxLength": 8,
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "contest",
    "problem",
    "events"
  ],
  "type": "object"
}
