{
  "$id": "RunResult.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "compileLog": {
      "type": [
        "string",
        "null"
      ]
    },
    "expected": {
      "type": [
        "string",
        "null"
      ]
    },
    "id": {
      "type": "string"
    },
    "matches": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "memKb": {
      "anyOf": [
        {
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "output": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "queued",
        "running",
        "done",
        "failed"
      ],
      "type": "string"
    },
    "stderr": {
      "type": [
        "string",
        "null"
      ]
    },
    "timeMs": {
      "anyOf": [
        {
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "verdict": {
      "anyOf": [
        {
          "$ref": "Verdict.json"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "id",
    "status",
    "verdict",
    "timeMs",
    "memKb",
    "output",
    "stderr",
    "compileLog",
    "expected",
    "matches"
  ],
  "type": "object"
}
