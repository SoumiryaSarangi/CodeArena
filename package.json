{
  "name": "codearena",
  "private": true,
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "eslint . && prettier --check .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm contracts:check",
    "format": "prettier --write .",
    "prepare": "lefthook install",
    "contracts:gen": "pnpm --filter @codearena/contracts gen",
    "contracts:check": "pnpm --filter @codearena/contracts gen --check",
    "db:reset": "pnpm --filter @codearena/api db:reset",
    "e2e": "pnpm --filter @codearena/web e2e",
    "problem:import": "pnpm --filter @codearena/api exec tsx --env-file-if-exists=.env src/modules/problems/import-cli.ts",
    "problems:build": "python3 scripts/problem-build.py problems/",
    "problems:validate": "scripts/validate-problem problems/",
    "problems:stress": "python3 scripts/stress-test.py",
    "attack": "scripts/attack",
    "eval:hints": "pnpm --filter @codearena/api eval:hints",
    "load:test": "node --test tests/load/lib.test.mjs tests/chaos/lib.test.mjs scripts/metrics-report.test.mjs",
    "chaos:local": "node tests/chaos/drill.mjs local",
    "load:local": "tests/load/local.sh",
    "ui-ux:sync": "node scripts/sync-ui-ux.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "lefthook": "^2.1.16",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "turbo": "^2.11.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
